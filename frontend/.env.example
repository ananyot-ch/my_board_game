# Frontend env vars (Vite — must be prefixed with VITE_)
# These are baked into the bundle at BUILD time, not runtime.

# Backend base URL.
# - Empty → uses Vite proxy in dev / nginx proxy in docker prod / window.origin
# - Cross-domain deploys (Vercel + Render): set to your backend public URL
# Example: VITE_API_URL=https://my-backend.onrender.com
VITE_API_URL=

# Socket.io URL — usually same as VITE_API_URL.
# Empty → falls back to window.location.origin
VITE_SOCKET_URL=

# Used only by `vite dev` to proxy /api & /socket.io to a different backend
# BACKEND_URL=http://localhost:3000
