# ─── App ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# Comma-separated list of allowed origins (or `*` for any).
# Example for prod: https://my-app.vercel.app,https://my-app-preview.vercel.app
FRONTEND_URL=http://localhost:5173

# ─── Database ────────────────────────────────────────────────────────────────
# Option A: Use DATABASE_URL (Neon, Render, Supabase) — takes precedence
# DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require

# Option B: Discrete vars (used if DATABASE_URL is not set — local dev)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=boardgame
DB_PASSWORD=boardgame_pass
DB_NAME=boardgame_db

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Min 32 random chars in production. Generate: `openssl rand -base64 48`
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# ─── Quiz AI providers (tried in order; falls back to local pool if all fail) ─
GEMINI_API_KEY=
GROQ_API_KEY=
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
OPENROUTER_API_KEY=
